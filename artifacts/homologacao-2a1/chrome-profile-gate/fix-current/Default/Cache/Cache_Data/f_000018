		`${currentYear}-${currentYear + 1}`,
		`${currentYear - 1}-${currentYear}`
	];
	for (const season of seasons) {
		try {
			const data = await fetchSportsDbJson(`lookuptable.php?l=${encodeURIComponent(leagueId)}&s=${encodeURIComponent(season)}`, signal);
			const rows = (data?.table || []).map(mapSportsDbStandingRow).filter((row) => row.team && !isWomenFootballText(row.team));
