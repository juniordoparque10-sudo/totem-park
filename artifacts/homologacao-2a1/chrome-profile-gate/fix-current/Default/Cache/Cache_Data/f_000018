		const tableRows = standingsResult[0]?.status === "fulfilled" && standingsResult[0].value.length ? standingsResult[0].value : primaryCompetition?.id === "brasileirao_a" ? DEFAULT_BRASILEIRAO_SERIE_A_TABLE_ROWS : [];
		if (!matches.length && !tableRows.length) return null;
		const realData = {
			source: "TheSportsDB",
			sourceSyncedAt: new Date().toLocaleTimeString("pt-BR", {
				hour: "2-digit",
				minute: "2-digit"
			}),
			competitions,
			liveFootball: [],
			finishedFootball,
			upcomingFootball,
			otherSportsEvents: realOtherSportsEvents.length ? realOtherSportsEvents : getSportsData(templateConfig).otherSportsEvents,
			selectedOtherSports,
			tableRows,
			primaryMatch: upcomingFootball[0] || finishedFootball[0] || matches[0] || getSportsData(templateConfig).primaryMatch
		};
