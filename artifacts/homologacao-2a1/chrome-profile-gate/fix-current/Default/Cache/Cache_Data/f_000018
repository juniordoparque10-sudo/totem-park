	const cacheKey = competitions.map((competition) => getSportsDbLeagueId(competition)).join("-");
	const cached = sportsDbMemoryCache.get(cacheKey);
	if (cached && Date.now() - cached.cachedAt < SPORTSDB_CACHE_TTL_MS) {
		return cached.data;
