mote-mini-button.blackout {\n  background: linear-gradient(180deg, rgba(71, 85, 105, 0.24), rgba(15, 23, 42, 0.2));\n  border-color: rgba(148, 163, 184, 0.18);\n  color: #f1f5f9;\n}\n\n.remote-mini-button.exit-tv {\n  grid-column: 1 / -1;\n  min-height: 42px;\n  margin-top: 2px;\n  background: rgba(239, 68, 68, 0.055);\n  border-color: rgba(248, 113, 113, 0.22);\n  color: #fca5a5;\n}\n\r\n.tv-overlay-alert {\r\n  position: fixed;\r\n  top: 24px;\r\n  right: 24px;\r\n  z-index: 9999;\r\n  max-width: 520px;\r\n  padding: 18px 22px;\r\n  border-radius: 20px;\r\n  background: rgba(15, 23, 42, 0.92);\r\n  border: 1px solid rgba(34, 211, 238, 0.35);\r\n  color: #ffffff;\r\n  backdrop-filter: blur(16px);\r\n  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);\r\n}\r\n\r\n.tv-overlay-alert strong {\r\n  display: block;\r\n  color: #67e8f9;\r\n  margin-bottom: 6px;\r\n  font-size: 18px;\r\n}\r\n\r\n.tv-overlay-alert span {\r\n  display: block;\r\n  font-size: 18px;\r\n  line-height: 1.35;\r\n}\r\n\r\n.tv-pause-badge {\r\n  position: fixed;\r\n  left: 24px;\r\n  bottom: 24px;\r\n  z-index: 9999;\r\n  padding: 12px 16px;\r\n  border-radius: 999px;\r\n  background: rgba(245, 158, 11, 0.18);\r\n  color: #fbbf24;\r\n  border: 1px solid rgba(245, 158, 11, 0.35);\r\n  font-weight: 950;\r\n  backdrop-filter: blur(12px);\r\n}\r\n\r\n.tv-takeover-screen {\r\n  background:\r\n    radial-gradient(circle at center, rgba(239, 68, 68, 0.16), transparent 38%),\r\n    #000000;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  text-align: center;\r\n  padding: 50px;\r\n}\r\n\r\n.tv-takeover-content {\r\n  max-width: 1200px;\r\n}\r\n\r\n.tv-takeover-content h1 {\r\n  font-size: clamp(48px, 8vw, 130px);\r\n  line-height: 1;\r\n  color: #ef4444;\r\n  margin-bottom: 28px;\r\n  text-transform: uppercase;\r\n  letter-spacing: 2px;\r\n}\r\n\r\n.tv-takeover-content p {\r\n  font-size: clamp(26px, 4vw, 58px);\r\n  line-height: 1.22;\r\n  color: #ffffff;\r\n  font-weight: 800;\r\n}\r\n\r\n.tv-maintenance-screen {\r\n  background:\r\n    radial-gradient(circle at top left, rgba(34, 211, 238, 0.12), transparent 35%),\r\n    radial-gradient(circle at bottom right, rgba(147, 51, 234, 0.18), transparent 35%),\r\n    #050816;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  text-align: center;\r\n  padding: 40px;\r\n}\r\n\r\n.tv-maintenance-screen img {\r\n  width: 220px;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.tv-maintenance-screen h1 {\r\n  font-size: clamp(38px, 5vw, 78px);\r\n}\r\n\r\n.tv-maintenance-screen p {\r\n  color: #cbd5e1;\r\n  font-size: clamp(20px, 2vw, 32px);\r\n  margin-top: 16px;\r\n}\r\n\r\n.tv-blackout-screen {\r\n  background: #000000;\r\n}\r\n\r\n@media (max-width: 760px) {\n  .remote-control-grid-inline {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\r\n  .tv-overlay-alert {\r\n    left: 16px;\r\n    right: 16px;\r\n    top: 16px;\r\n  }\r\n}\r\n\r\n\r\n\r\n.remote-mini-button.active-maintenance {\r\n  background: rgba(245, 158, 11, 0.18);\r\n  color: #fbbf24;\r\n}\r\n\r\n\r\n\r\n/* NOVA TELA DE MANUTENÇÃO */\r\n\r\n.tv-maintenance-screen {\n  background:\n    radial-gradient(circle at top left, rgba(34, 211, 238, 0.10), transparent 35%),\n    radial-gradient(circle at bottom right, rgba(147, 51, 234, 0.18), transparent 35%),\n    #020617;\n  padding: clamp(24px, 4vw, 56px);\n}\n\n.tv-maintenance-content {\n  width: min(86vw, 820px);\n  max-height: 86vh;\n  text-align: center;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: clamp(10px, 1.5vw, 18px);\n  padding: clamp(22px, 3vw, 40px);\n  border-radius: clamp(26px, 3vw, 42px);\n  background: rgba(2, 6, 23, 0.42);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  box-shadow: 0 28px 90px rgba(0, 0, 0, 0.35);\n}\n\n.tv-maintenance-content img {\n  width: clamp(140px, 16vw, 230px);\n  margin: 0 auto;\n}\n\n.tv-maintenance-icon {\n  font-size: clamp(42px, 5vw, 72px);\n  line-height: 1;\n  margin: 0;\n}\n\n.tv-maintenance-content h1 {\n  font-size: clamp(38px, 5.2vw, 86px);\n  line-height: 0.98;\n  font-weight: 950;\n  margin: 0;\n}\n\r\n.tv-maintenance-content h1 span {\r\n  background: linear-gradient(135deg, #06b6d4, #9333ea);\r\n  -webkit-background-clip: text;\r\n  -webkit-text-fill-color: transparent;\r\n}\r\n\r\n.tv-maintenance-divider {\n  width: min(380px, 72%);\n  max-width: 80%;\n  height: 3px;\n  border-radius: 999px;\n  margin: 0 auto;\n  background: linear-gradient(90deg, #06b6d4, #9333ea);\n  position: relative;\n}\n\r\n.tv-maintenance-divider::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  width: 14px;\r\n  height: 14px;\r\n  border-radius: 999px;\r\n  background: #a855f7;\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -50%);\r\n}\r\n\r\n.tv-maintenance-content p {\n  max-width: 680px;\n  margin: 0 auto;\n  color: #e2e8f0;\n  font-size: clamp(18px, 2.2vw, 30px);\n  line-height: 1.4;\n}\n\n.tv-maintenance-loader {\n  width: clamp(34px, 4vw, 48px);\n  height: clamp(34px, 4vw, 48px);\n  margin: 8px auto 0;\n  border-radius: 999px;\n  border: 4px solid rgba(168, 85, 247, 0.18);\n  border-top-color: #a855f7;\r\n  animation: maintenance-spin 1s linear infinite;\r\n}\r\n\r\n@keyframes maintenance-spin {\r\n  to {\r\n    transform: rotate(360deg);\r\n  }\r\n}\r\n\r\n\r\n/* =====================================================\r\n   APP ANDROID - ESCOLHA MODO GESTOR OU MODO TV\r\n   WEB continua igual.\r\n===================================================== */\r\n\r\n.app-mode-page {\r\n  min-height: 100vh;\r\n  padding: 28px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background:\r\n    radial-gradient(circle at top left, rgba(34, 211, 238, 0.16), transparent 34%),\r\n    radial-gradient(circle at bottom right, rgba(147, 51, 234, 0.22), transparent 38%),\r\n    #050816;\r\n  color: #ffffff;\r\n}\r\n\r\n.app-mode-card {\r\n  width: min(980px, 100%);\r\n  padding: 42px;\r\n  border-radius: 34px;\r\n  background: rgba(15, 23, 42, 0.94);\r\n  border: 1px solid rgba(255, 255, 255, 0.11);\r\n  box-shadow: 0 34px 100px rgba(0, 0, 0, 0.55);\r\n  text-align: center;\r\n}\r\n\r\n.app-mode-card > img {\r\n  width: 210px;\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.app-mode-kicker {\r\n  width: fit-content;\r\n  margin: 0 auto 18px;\r\n  padding: 8px 14px;\r\n  border-radius: 999px;\r\n  color: #67e8f9;\r\n  background: rgba(34, 211, 238, 0.12);\r\n  border: 1px solid rgba(34, 211, 238, 0.28);\r\n  font-size: 13px;\r\n  font-weight: 950;\r\n  letter-spacing: 1px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.app-mode-card h1 {\r\n  font-size: clamp(36px, 5vw, 64px);\r\n  line-height: 1;\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.app-mode-card p {\r\n  color: #cbd5e1;\r\n  font-size: 18px;\r\n  line-height: 1.45;\r\n}\r\n\r\n.app-mode-card p strong {\r\n  color: #ffffff;\r\n}\r\n\r\n.app-mode-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 18px;\r\n  margin-top: 34px;\r\n}\r\n\r\n.app-mode-option {\r\n  min-height: 230px;\r\n  border: none;\r\n  border-radius: 28px;\r\n  padding: 28px;\r\n  text-align: left;\r\n  color: #ffffff;\r\n  cursor: pointer;\r\n  transition: 0.22s;\r\n}\r\n\r\n.app-mode-option:hover {\r\n  transform: translateY(-4px);\r\n  filter: brightness(1.08);\r\n}\r\n\r\n.app-mode-option span {\r\n  display: inline-flex;\r\n  padding: 8px 12px;\r\n  border-radius: 999px;\r\n  font-size: 12px;\r\n  font-weight: 950;\r\n  text-transform: uppercase;\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.app-mode-option strong {\r\n  display: block;\r\n  font-size: 30px;\r\n  line-height: 1.1;\r\n  margin-bottom: 14px;\r\n}\r\n\r\n.app-mode-option p {\r\n  color: rgba(255, 255, 255, 0.82);\r\n  font-size: 16px;\r\n}\r\n\r\n.app-mode-option.manager {\r\n  background:\r\n    radial-gradient(circle at top left, rgba(34, 211, 238, 0.16), transparent 35%),\r\n    rgba(255, 255, 255, 0.055);\r\n  border: 1px solid rgba(34, 211, 238, 0.26);\r\n}\r\n\r\n.app-mode-option.manager span {\r\n  color: #67e8f9;\r\n  background: rgba(34, 211, 238, 0.14);\r\n}\r\n\r\n.app-mode-option.tv {\r\n  background:\r\n    radial-gradient(circle at top left, rgba(147, 51, 234, 0.18), transparent 35%),\r\n    rgba(255, 255, 255, 0.055);\r\n  border: 1px solid rgba(147, 51, 234, 0.30);\r\n}\r\n\r\n.app-mode-option.tv span {\r\n  color: #d8b4fe;\r\n  background: rgba(147, 51, 234, 0.16);\r\n}\r\n\r\n.app-mode-logout,\r\n.tv-change-mode-button {\r\n  margin-top: 24px;\r\n  min-height: 50px;\r\n  border: none;\r\n  border-radius: 16px;\r\n  padding: 0 20px;\r\n  background: rgba(255, 255, 255, 0.075);\r\n  color: #cbd5e1;\r\n  font-weight: 850;\r\n  cursor: pointer;\r\n}\r\n\r\n.native-mode-switch {\r\n  margin-bottom: 22px;\r\n  padding: 14px 16px;\r\n  border-radius: 18px;\r\n  background: rgba(34, 211, 238, 0.10);\r\n  border: 1px solid rgba(34, 211, 238, 0.22);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 14px;\r\n}\r\n\r\n.native-mode-switch span {\r\n  color: #67e8f9;\r\n  font-weight: 900;\r\n}\r\n\r\n.native-mode-switch button {\r\n  min-height: 40px;\r\n  border: none;\r\n  border-radius: 13px;\r\n  padding: 0 16px;\r\n  background: rgba(255, 255, 255, 0.08);\r\n  color: #ffffff;\r\n  font-weight: 850;\r\n  cursor: pointer;\r\n}\r\n\r\n/* =====================================================\r\n   MODO TV - ORIENTAÇÃO DA TELA PELO PAINEL\r\n   Somente o player usa isso. O gestor segue orientação normal.\r\n===================================================== */\r\n\r\n.player-screen {\r\n  position: fixed !important;\r\n  inset: 0 !important;\r\n  width: 100vw !important;\r\n  height: 100vh !important;\r\n  overflow: hidden !important;\r\n  background: #000000 !important;\r\n  cursor: none;\r\n  user-select: none;\r\n  -webkit-user-select: none;\r\n  touch-action: none;\r\n}\r\n\r\n.player-screen.landscape-mode .player-media {\n  position: absolute !important;\r\n  inset: 0 !important;\r\n  width: 100vw !important;\r\n  height: 100vh !important;\r\n  object-fit: cover !important;\r\n  transform: none !important;\r\n}\r\n\r\n.player-screen.portrait-mode .player-media {\r\n  position: absolute !important;\r\n  top: 50% !important;\r\n  left: 50% !important;\r\n  width: 100vh !important;\r\n  height: 100vw !important;\r\n  object-fit: cover !important;\r\n  transform: translate(-50%, -50%) rotate(90deg) !important;\r\n  transform-origin: center center !important;\r\n}\r\n\r\n.player-screen.portrait-mode .player-schedule-label,\r\n.player-screen.portrait-mode .tv-overlay-alert,\r\n.player-screen.portrait-mode .tv-pause-badge {\r\n  transform: rotate(90deg) !important;\r\n  transform-origin: center center !important;\r\n}\r\n\r\n.player-screen.portrait-mode.tv-maintenance-screen,\r\n.player-screen.portrait-mode.tv-takeover-screen {\r\n  display: flex !important;\r\n  align-items: center !important;\r\n  justify-content: center !important;\r\n}\r\n\r\n.player-screen.portrait-mode .tv-maintenance-content,\n.player-screen.portrait-mode .tv-takeover-content {\n  width: 100vh !important;\n  min-height: 100vw !important;\n  transform: rotate(90deg) !important;\n  transform-origin: center center !important;\r\n  display: flex !important;\r\n  flex-direction: column !important;\r\n  align-items: center !important;\r\n  justify-content: center !important;\n}\n\n.player-screen.portrait-mode .tv-maintenance-content {\n  width: min(82vh, 720px) !important;\n  min-height: auto !important;\n  max-height: 82vw !important;\n  padding: clamp(18px, 3vw, 34px) !important;\n}\n\r\n@media (max-width: 780px) {\r\n  .app-mode-card {\r\n    padding: 28px;\r\n  }\r\n\r\n  .app-mode-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .app-mode-option {\r\n    min-height: 190px;\r\n  }\r\n}\r\n\r\n\r\n/* =====================================================\r\n   FIX 14/06 - RESTAURA UPLOAD, PREVIEW, CONTROLE E PLAYER\r\n===================================================== */\r\n\r\n/* Esconde definitivamente o input HTML padrão de arquivo */\r\n.file-input-hidden,\n.modern-upload-group input[type=\"file\"],\n.file-dropzone input[type=\"file\"] {\n  display: block !important;\n  opacity: 0 !important;\n  width: 1px !important;\n  height: 1px !important;\n  position: absolute !important;\n  overflow: hidden !important;\n  clip-path: inset(50%) !important;\n  white-space: nowrap !important;\n}\n\r\n/* Garante que o botão bonito do upload fique visível */\r\n.file-dropzone {\r\n  width: 100%;\r\n}\r\n\r\n.file-upload-button {\r\n  cursor: pointer;\r\n  user-select: none;\r\n}\r\n\r\n.file-upload-button * {\r\n  pointer-events: none;\r\n}\r\n\r\n.modern-upload-title label {\r\n  color: #ffffff !important;\r\n}\r\n\r\n/* Mini preview real no dashboard do gestor */\r\n.premium-screen-thumb {\r\n  overflow: hidden !important;\r\n  padding: 0 !important;\r\n  background: linear-gradient(135deg, #11182f, #3b1767) !important;\r\n}\r\n\r\n.premium-screen-thumb img,\r\n.premium-screen-thumb video {\r\n  width: 100% !important;\r\n  height: 100% !important;\r\n  object-fit: cover !important;\r\n  display: block !important;\r\n}\r\n\r\n.premium-screen-thumb svg {\r\n  margin: auto;\r\n}\r\n\r\n/* Player mais estável */\r\n.player-screen {\r\n  background: #000000 !important;\r\n}\r\n\r\n.player-media {\r\n  width: 100% !important;\r\n  height: 100% !important;\r\n  object-fit: cover !important;\r\n  background: #000000 !important;\r\n  backface-visibility: hidden !important;\r\n  transform: translateZ(0) !important;\r\n}\r\n\r\nvideo.player-media {\r\n  pointer-events: none !important;\r\n}\r\n\r\nvideo.player-media::-webkit-media-controls,\r\nvideo.player-media::-webkit-media-controls-panel,\r\nvideo.player-media::-webkit-media-controls-play-button,\r\nvideo.player-media::-webkit-media-controls-start-playback-button {\r\n  display: none !important;\r\n  opacity: 0 !important;\r\n  pointer-events: none !important;\r\n  -webkit-appearance: none !important;\r\n}\r\n\r\n.tv-change-mode-button {\r\n  width: 100%;\r\n  min-height: 54px;\r\n  border: none;\r\n  border-radius: 16px;\r\n  margin-top: 16px;\r\n  padding: 0 18px;\r\n  background: rgba(255, 255, 255, 0.08);\r\n  color: #ffffff;\r\n  font-weight: 900;\r\n  cursor: pointer;\r\n}\r\n\r\n.tv-change-mode-button.secondary {\r\n  background: rgba(239, 68, 68, 0.16);\r\n  color: #fca5a5;\r\n}\r\n\r\n\r\n/* =====================================================\r\n   FIX FINAL - PRÉ-CARREGAMENTO DO PRÓXIMO VÍDEO\r\n   Reduz tela preta entre vídeos usando preload invisível.\r\n===================================================== */\r\n\r\n.player-preload-media {\r\n  position: fixed !important;\r\n  width: 1px !important;\r\n  height: 1px !important;\r\n  left: -99999px !important;\r\n  top: -99999px !important;\r\n  opacity: 0 !important;\r\n  pointer-events: none !important;\r\n  overflow: hidden !important;\r\n  z-index: -1 !important;\r\n}\r\n\r\n.player-preload-media video,\r\n.player-preload-media img {\r\n  width: 1px !important;\r\n  height: 1px !important;\r\n  opacity: 0 !important;\r\n}\r\n\r\n.player-media {\r\n  animation: playerFastSmoothFade 0.28s ease-in-out both !important;\r\n  will-change: opacity, transform;\r\n}\r\n\r\n@keyframes playerFastSmoothFade {\r\n  from {\r\n    opacity: 0.15;\r\n    transform: scale(1.003);\r\n  }\r\n\r\n  to {\r\n    opacity: 1;\r\n    transform: scale(1);\r\n  }\r\n}\r\n\r\n\r\n/* =====================================================\r\n   FIX PLAYER - TROCA POR TEMPO CONFIGURADO\r\n===================================================== */\r\n\r\n.player-media {\r\n  animation: playerNoBlackFade 0.16s ease-out both !important;\r\n  background: #000000 !important;\r\n}\r\n\r\n@keyframes playerNoBlackFade {\r\n  from {\r\n    opacity: 0.45;\r\n  }\r\n\r\n  to {\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n\r\n/* =====================================================\r\n   FIX TRANSIÇÕES REAIS DA PLAYLIST\r\n   Agora cada opção do select aplica uma animação diferente.\r\n===================================================== */\r\n\r\n.player-media.transition-fade {\r\n  animation: totemTransitionFade 0.42s ease-in-out both !important;\r\n}\r\n\r\n.player-media.transition-slide {\r\n  animation: totemTransitionSlide 0.46s ease-out both !important;\r\n}\r\n\r\n.player-media.transition-zoom {\r\n  animation: totemTransitionZoom 0.46s ease-out both !important;\r\n}\r\n\r\n.player-media.transition-cut {\r\n  animation: none !important;\r\n  opacity: 1 !important;\r\n  transform: none !important;\r\n}\r\n\r\n.player-media.transition-dissolve {\r\n  animation: totemTransitionDissolve 0.55s ease-in-out both !important;\r\n}\r\n\r\n@keyframes totemTransitionFade {\r\n  from {\r\n    opacity: 0.35;\r\n  }\r\n  to {\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n@keyframes totemTransitionSlide {\r\n  from {\r\n    opacity: 0.45;\r\n    transform: translateX(22px) scale(1.01);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: translateX(0) scale(1);\r\n  }\r\n}\r\n\r\n@keyframes totemTransitionZoom {\r\n  from {\r\n    opacity: 0.45;\r\n    transform: scale(1.045);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: scale(1);\r\n  }\r\n}\r\n\r\n@keyframes totemTransitionDissolve {\r\n  0% {\r\n    opacity: 0.18;\r\n    filter: blur(8px);\r\n  }\r\n  55% {\r\n    opacity: 0.72;\r\n    filter: blur(2px);\r\n  }\r\n  100% {\r\n    opacity: 1;\r\n    filter: blur(0);\r\n  }\r\n}\r\n\r\n/* Mantém fundo preto, mas evita animação antiga sobrescrever a nova */\r\n.player-media {\r\n  will-change: opacity, transform, filter;\r\n}\r\n\r\n\r\n/* =====================================================\r\n   FIX PREVIEW AO VIVO + VOLTAR DO /TV\r\n===================================================== */\r\n\r\n.screen-live-preview video,\r\n.media-preview.screen-preview video,\r\n.premium-screen-thumb video {\r\n  display: block !important;\r\n  background: #000000 !important;\r\n}\r\n\r\n.tv-change-mode-button.tertiary {\r\n  background: rgba(34, 211, 238, 0.12);\r\n  color: #67e8f9;\r\n}\r\n\r\n.tv-player-exit-button {\r\n  position: fixed;\r\n  right: 18px;\r\n  bottom: 18px;\r\n  z-index: 99999;\r\n  min-height: 42px;\r\n  padding: 0 14px;\r\n  border: none;\r\n  border-radius: 999px;\r\n  background: rgba(15, 23, 42, 0.72);\r\n  color: #ffffff;\r\n  font-weight: 900;\r\n  cursor: pointer;\r\n  opacity: 0.22;\r\n  backdrop-filter: blur(12px);\r\n  transition: 0.2s;\r\n}\r\n\r\n.tv-player-exit-button:hover {\r\n  opacity: 1;\r\n  background: rgba(239, 68, 68, 0.82);\r\n}\r\n\r\n\r\n/* =====================================================\r\n   FIX PREVIEW VISUAL AO VIVO\r\n   O texto já mudava; agora a imagem/vídeo também força atualização.\r\n===================================================== */\r\n\r\n.screen-live-preview video,\r\n.screen-live-preview img,\r\n.media-preview.screen-preview video,\r\n.media-preview.screen-preview img,\r\n.premium-screen-thumb video,\r\n.premium-screen-thumb img {\r\n  width: 100% !important;\r\n  height: 100% !important;\r\n  object-fit: cover !important;\r\n  display: block !important;\r\n  background: #000000 !important;\r\n}\r\n\r\n\r\n/* =====================================================\r\n   FIX DEFINITIVO PREVIEW AO VIVO + TRANSIÇÕES DO PLAYER\r\n===================================================== */\r\n\r\n.screen-live-preview img,\r\n.screen-live-preview video,\r\n.media-preview.screen-preview img,\r\n.media-preview.screen-preview video,\r\n.premium-screen-thumb img,\r\n.premium-screen-thumb video {\r\n  width: 100% !important;\r\n  height: 100% !important;\r\n  object-fit: cover !important;\r\n  display: block !important;\r\n  background: #000000 !important;\r\n}\r\n\r\n.player-media.transition-fade {\r\n  animation: tpFade 0.45s ease-in-out both !important;\r\n}\r\n\r\n.player-media.transition-slide {\r\n  animation: tpSlide 0.5s ease-out both !important;\r\n}\r\n\r\n.player-media.transition-zoom {\r\n  animation: tpZoom 0.5s ease-out both !important;\r\n}\r\n\r\n.player-media.transition-cut {\r\n  animation: none !important;\r\n  opacity: 1 !important;\r\n  transform: none !important;\r\n  filter: none !important;\r\n}\r\n\r\n.player-media.transition-dissolve {\r\n  animation: tpDissolve 0.65s ease-in-out both !important;\r\n}\r\n\r\n@keyframes tpFade {\r\n  from { opacity: 0.25; }\r\n  to { opacity: 1; }\r\n}\r\n\r\n@keyframes tpSlide {\r\n  from { opacity: 0.35; transform: translateX(32px); }\r\n  to { opacity: 1; transform: translateX(0); }\r\n}\r\n\r\n@keyframes tpZoom {\r\n  from { opacity: 0.35; transform: scale(1.06); }\r\n  to { opacity: 1; transform: scale(1); }\r\n}\r\n\r\n@keyframes tpDissolve {\r\n  0% { opacity: 0.12; filter: blur(10px); }\r\n  60% { opacity: 0.72; filter: blur(2px); }\r\n  100% { opacity: 1; filter: blur(0); }\r\n}\r\n\r\n\r\n/* =====================================================\r\n   TRANSIÇÕES CONFIGURÁVEIS - TIPO + VELOCIDADE\r\n   Este bloco deve ficar no final para sobrescrever todos os anteriores.\r\n===================================================== */\r\n\r\n.player-media.speed-fast {\r\n  --tp-transition-duration: 0.22s;\r\n}\r\n\r\n.player-media.speed-normal {\r\n  --tp-transition-duration: 0.45s;\r\n}\r\n\r\n.player-media.speed-slow {\r\n  --tp-transition-duration: 0.85s;\r\n}\r\n\r\n.player-media.speed-cinematic {\r\n  --tp-transition-duration: 1.35s;\r\n}\r\n\r\n.player-media.transition-fade {\r\n  animation-name: tpRealFade !important;\r\n  animation-duration: var(--tp-transition-duration) !important;\r\n  animation-timing-function: ease-in-out !important;\r\n  animation-fill-mode: both !important;\r\n}\r\n\r\n.player-media.transition-slide {\r\n  animation-name: tpRealSlide !important;\r\n  animation-duration: var(--tp-transition-duration) !important;\r\n  animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1) !important;\r\n  animation-fill-mode: both !important;\r\n}\r\n\r\n.player-media.transition-zoom {\r\n  animation-name: tpRealZoom !important;\r\n  animation-duration: var(--tp-transition-duration) !important;\r\n  animation-timing-function: ease-out !important;\r\n  animation-fill-mode: both !important;\r\n}\r\n\r\n.player-media.transition-cut {\r\n  animation: none !important;\r\n  opacity: 1 !important;\r\n  transform: none !important;\r\n  filter: none !important;\r\n}\r\n\r\n.player-media.transition-dissolve {\r\n  animation-name: tpRealDissolve !important;\r\n  animation-duration: var(--tp-transition-duration) !important;\r\n  animation-timing-function: ease-in-out !important;\r\n  animation-fill-mode: both !important;\r\n}\r\n\r\n@keyframes tpRealFade {\r\n  from {\r\n    opacity: 0.05;\r\n  }\r\n\r\n  to {\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n@keyframes tpRealSlide {\r\n  from {\r\n    opacity: 0.15;\r\n    transform: translateX(9vw) scale(1.015);\r\n  }\r\n\r\n  to {\r\n    opacity: 1;\r\n    transform: translateX(0) scale(1);\r\n  }\r\n}\r\n\r\n@keyframes tpRealZoom {\r\n  from {\r\n    opacity: 0.15;\r\n    transform: scale(1.12);\r\n  }\r\n\r\n  to {\r\n    opacity: 1;\r\n    transform: scale(1);\r\n  }\r\n}\r\n\r\n@keyframes tpRealDissolve {\r\n  0% {\r\n    opacity: 0;\r\n    filter: blur(14px) brightness(0.8);\r\n  }\r\n\r\n  55% {\r\n    opacity: 0.65;\r\n    filter: blur(5px) brightness(1.05);\r\n  }\r\n\r\n  100% {\r\n    opacity: 1;\r\n    filter: blur(0) brightness(1);\r\n  }\r\n}\r\n\r\n\r\n/* =====================================================\r\n   FIX REAL - TRANSIÇÃO NO WRAPPER + CONTROLE REMOTO\r\n   A animação agora fica na camada do player, não no video.\r\n===================================================== */\r\n\r\n.player-transition-layer {\r\n  position: absolute !important;\r\n  inset: 0 !important;\r\n  width: 100% !important;\r\n  height: 100% !important;\r\n  background: #000000 !important;\r\n  overflow: hidden !important;\r\n  --tp-transition-duration: 0.45s;\r\n  will-change: opacity, transform, filter;\r\n}\r\n\r\n.player-transition-layer.speed-fast {\r\n  --tp-transition-duration: 0.22s;\r\n}\r\n\r\n.player-transition-layer.speed-normal {\r\n  --tp-transition-duration: 0.55s;\r\n}\r\n\r\n.player-transition-layer.speed-slow {\r\n  --tp-transition-duration: 1s;\r\n}\r\n\r\n.player-transition-layer.speed-cinematic {\r\n  --tp-transition-duration: 1.65s;\r\n}\r\n\r\n.player-transition-layer.transition-fade.transition-active {\n  animation: tpLayerFade var(--tp-transition-duration) ease-in-out both !important;\r\n}\r\n\r\n.player-transition-layer.transition-slide.transition-active {\n  animation: tpLayerSlide var(--tp-transition-duration) cubic-bezier(0.22, 1, 0.36, 1) both !important;\r\n}\r\n\r\n.player-transition-layer.transition-zoom.transition-active {\n  animation: tpLayerZoom var(--tp-transition-duration) ease-out both !important;\r\n}\r\n\r\n.player-transition-layer.transition-cut.transition-active {\n  animation: none !important;\r\n}\r\n\r\n.player-transition-layer.transition-dissolve.transition-active {\n  animation: tpLayerDissolve var(--tp-transition-duration) ease-in-out both !important;\r\n}\r\n\r\n@keyframes tpLayerFade {\r\n  from { opacity: 0; }\r\n  to { opacity: 1; }\r\n}\r\n\r\n@keyframes tpLayerSlide {\r\n  from {\r\n    opacity: 0.2;\r\n    transform: translateX(14vw);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: translateX(0);\r\n  }\r\n}\r\n\r\n@keyframes tpLayerZoom {\r\n  from {\r\n    opacity: 0.2;\r\n    transform: scale(1.16);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: scale(1);\r\n  }\r\n}\r\n\r\n@keyframes tpLayerDissolve {\r\n  0% {\r\n    opacity: 0;\r\n    filter: blur(18px) brightness(0.7);\r\n  }\r\n  50% {\r\n    opacity: 0.65;\r\n    filter: blur(7px) brightness(1.08);\r\n  }\r\n  100% {\r\n    opacity: 1;\r\n    filter: blur(0) brightness(1);\r\n  }\r\n}\r\n\r\n.player-transition-layer .player-media {\n  animation: none !important;\n}\n\n@media (max-width: 1280px) {\n  .remote-control-panel-inline {\n    padding: 16px;\n  }\n\n  .remote-control-heading {\n    align-items: flex-start;\n    gap: 8px;\n  }\n\n  .remote-control-title {\n    min-width: 0;\n    font-size: 12px;\n    line-height: 1.12;\n    letter-spacing: 0.55px;\n  }\n\n  .remote-live-label {\n    flex: 0 0 auto;\n    font-size: 9px;\n    line-height: 1.05;\n    text-align: center;\n  }\n\n  .remote-control-grid-inline {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 9px;\n  }\n\n  .remote-mini-button {\n    min-height: 48px;\n    padding: 6px 7px;\n    gap: 5px;\n    font-size: 10px;\n    line-height: 1.08;\n  }\n\n  .remote-mini-button svg {\n    width: 14px;\n    height: 14px;\n  }\n\n  .remote-mini-button span {\n    max-width: 100%;\n    line-height: 1.08;\n    overflow-wrap: anywhere;\n    word-break: normal;\n  }\n\n  .remote-mini-button.exit-tv {\n    grid-column: 1 / -1;\n  }\n}\n\n/* Planos comerciais e identidade visual do cliente. */\n.client-avatar {\n  overflow: hidden;\n  flex: 0 0 auto;\n}\n\n.client-avatar img,\n.client-logo-preview img {\n  width: 100%;\n  height: 100%;\n  display: block;\n  object-fit: cover;\n}\n\n.client-sidebar-profile,\n.client-dashboard-identity {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  min-width: 0;\n}\n\n.client-sidebar-profile .client-avatar {\n  width: 42px;\n  height: 42px;\n  border-radius: 14px;\n}\n\n.client-sidebar-profile > div:last-child {\n  min-width: 0;\n}\n\n.client-avatar-dashboard {\n  width: 76px;\n  height: 76px;\n  border-radius: 22px;\n  display: grid;\n  place-items: center;\n  color: #ffffff;\n  font-size: 28px;\n  font-weight: 900;\n  background: linear-gradient(135deg, #06b6d4, #9333ea);\n  border: 1px solid rgba(255, 255, 255, 0.16);\n  box-shadow: 0 16px 36px rgba(15, 23, 42, 0.32);\n}\n\n.client-logo-field {\n  grid-column: 1 / -1;\n}\n\n.client-logo-upload {\n  min-height: 90px;\n  padding: 14px;\n  border-radius: 18px;\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  cursor: pointer