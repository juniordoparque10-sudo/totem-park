rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMaster() {
      return signedIn()
        && (
          (
            exists(/databases/$(database)/documents/settings/masterAccess)
            && request.auth.token.email in get(/databases/$(database)/documents/settings/masterAccess).data.emails
          )
          || (
            !exists(/databases/$(database)/documents/settings/masterAccess)
            && request.auth.token.email in [
              "admin@parksolutions.com",
              "juniordoparque10@gmail.com"
            ]
          )
        );
    }

    function clientDoc(clientId) {
      return get(/databases/$(database)/documents/clients/$(clientId));
    }

    function isClientOwner(clientId) {
      return signedIn()
        && (
          clientDoc(clientId).data.get("uid", "") == request.auth.uid
          || clientDoc(clientId).data.get("email", "") == request.auth.token.get("email", "missing-email")
        )
        && clientDoc(clientId).data.get("accountStatus", "active") != "pending_commercial_validation";
    }

    function isClientOperational(clientId) {
      return !clientDoc(clientId).data.keys().hasAny(["lifecycleStatus"])
        || (clientDoc(clientId).data.lifecycleStatus != "deletion_pending"
          && clientDoc(clientId).data.lifecycleStatus != "permanently_deleted");
    }

    function changesFinancialSummary() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "financialModelVersion",
        "financialMode",
        "activeContractId",
        "financialStatus",
        "financialRestriction",
        "financialDaysOverdue",
        "financialReferenceInvoiceId",
        "financialUpdatedAt",
        "financialRevision",
        "dueDate",
        "billing",
        "plan",
        "status",
        "suspensionReason",
        "suspendedAt",
        "graceUnlockUntil",
        "accountStatus",
        "lifecycleStatus",
        "accessDisabled",
        "deletionOperationId",
        "deletedAt",
        "deletedByUid",
        "deletedIdentityUidHash",
        "deletedIdentityEmailHash"
      ]);
    }

    function isFinancialSubcollection(name) {
      return name in [
        "contracts",
        "invoices",
        "financialNotifications",
        "financialAudit",
        "financialEmailDeliveries"
      ];
    }

    function isOwnAccountRequest() {
      return signedIn()
        && resource.data.email == request.auth.token.email;
    }

    function isValidPublicAccountRequestCreate() {
      return request.resource.data.accountStatus == "pending_commercial_validation"
        && request.resource.data.status == "Nova solicitação"
        && request.resource.data.keys().hasAll([
          "responsibleName",
          "email",
          "whatsapp",
          "role",
          "companyName",
          "segment",
          "city",
          "state",
          "screensEstimate",
          "intendedUse",
          "accountStatus",
          "status",
          "createdAt",
          "updatedAt"
        ]);
    }

    function isAllowedPublicScreenUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "activeDeviceId",
        "activePlaylistWeightBytes",
        "cacheSizeBytes",
        "cacheManifestItems",
        "cacheManifestKey",
        "cacheManifestSizeBytes",
        "cacheDownloadedItems",
        "cacheRemovedItems",
        "cacheStatus",
        "cacheUpdatedAt",
        "cachedItems",
        "commandStatus",
        "connectedDeviceId",
        "currentMediaSource",
        "currentPlaylistId",
        "currentPlaylistMode",
        "currentPlaylistName",
        "deviceLocation",
        "deviceLocationCity",
        "deviceLocationUpdatedAt",
        "failedCacheItems",
        "estimatedMonthlyTrafficBytes",
        "lastCommandExecuted",
        "lastCommandExecutedAt",
        "lastCommandSent",
        "lastConnection",
        "lastMediaDownloadAt",
        "lastMediaDownloadBytes",
        "lastMediaUpdateAt",
        "lastSeenAt",
        "nowPlayingAspectRatio",
        "nowPlayingDuration",
        "nowPlayingHeight",
        "nowPlayingIndex",
        "nowPlayingItemType",
        "nowPlayingOrientation",
        "nowPlayingPreview",
        "nowPlayingSound",
        "nowPlayingTemplateType",
        "nowPlayingTitle",
        "nowPlayingTotal",
        "nowPlayingType",
        "nowPlayingWidth",
        "remoteCommand",
        "status",
        "totalCacheableItems"
      ]);
    }

    function playerBinding() {
      return get(/databases/$(database)/documents/playerDeviceBindings/$(request.auth.uid));
    }

    function hasActivePlayerBinding(clientId, screenId) {
      return signedIn()
        && exists(/databases/$(database)/documents/playerDeviceBindings/$(request.auth.uid))
        && playerBinding().data.uid == request.auth.uid
        && playerBinding().data.status == "ACTIVE"
        && playerBinding().data.clientId == clientId
        && playerBinding().data.screenId == screenId;
    }

    function telemetryIdentityMatches(clientId, screenId, telemetry) {
      return telemetry.session.clientId == clientId
        && telemetry.session.screenId == screenId
        && telemetry.session.deviceId == playerBinding().data.deviceId;
    }

    function historyIdentityMatches(clientId, screenId, payload) {
      return payload.clientId == clientId
        && payload.screenId == screenId
        && payload.deviceId == playerBinding().data.deviceId;
    }

    function validTelemetryDayId(dayId) {
      return dayId.matches('^(?:(?:[0-9]{4})-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$');
    }

    function validDailyTelemetryTypes(payload) {
      return payload.schemaVersion is int
        && payload.dateKey is string
        && payload.clientId is string
        && payload.screenId is string
        && payload.deviceId is string
        && payload.sequence is int
        && payload.internetRxBytes is int
        && payload.internetTxBytes is int
        && payload.mediaDownloadedBytes is int
        && payload.cacheReusedBytes is int
        && payload.trafficAvoidedBytes is int
        && payload.cachePlaybackHits is int
        && payload.remotePlaybackCount is int
        && payload.fallbackPlaybackCount is int
        && payload.cacheablePlaybackCount is int
        && (payload.cacheHitRate == null || payload.cacheHitRate is number)
        && payload.observedUptimeSeconds is number
        && payload.provedPlaybackSeconds is number
        && payload.provedOnlineSeconds is number
        && payload.provedOfflineSeconds is number
        && payload.sessionIds is list
        && payload.sessionCount is int
        && payload.restartCount is int
        && payload.failureCount is int
        && payload.unknownInterruptionCount is int
        && payload.packageName is string
        && (payload.versionCode == null || payload.versionCode is int)
        && payload.versionName is string
        && payload.lastCommunicationAt is string;
    }

    function validDailyTelemetryValues(payload) {
      return payload.schemaVersion == 1
        && payload.sequence >= 1
        && payload.internetRxBytes >= 0
        && payload.internetTxBytes >= 0
        && payload.mediaDownloadedBytes >= 0
        && payload.cacheReusedBytes >= 0
        && payload.trafficAvoidedBytes >= 0
        && payload.cachePlaybackHits >= 0
        && payload.remotePlaybackCount >= 0
        && payload.fallbackPlaybackCount >= 0
        && payload.cacheablePlaybackCount == payload.cachePlaybackHits + payload.remotePlaybackCount + payload.fallbackPlaybackCount
        && ((payload.cacheablePlaybackCount == 0 && payload.cacheHitRate == null)
          || (payload.cacheablePlaybackCount > 0 && payload.cacheHitRate >= 0 && payload.cacheHitRate <= 1))
        && payload.observedUptimeSeconds >= 0
        && payload.provedPlaybackSeconds >= 0
        && payload.provedOnlineSeconds >= 0
        && payload.provedOfflineSeconds >= 0
        && payload.sessionCount == payload.sessionIds.size()
        && payload.restartCount >= 0
        && payload.failureCount >= 0
        && payload.unknownInterruptionCount >= 0
        && (payload.versionCode == null || payload.versionCode >= 0);
    }

    function validDailyTelemetry(clientId, screenId, dayId, payload) {
      return isClientOperational(clientId)
        && hasActivePlayerBinding(clientId, screenId)
        && historyIdentityMatches(clientId, screenId, payload)
        && payload.keys().hasOnly([
          "schemaVersion", "dateKey", "clientId", "screenId", "deviceId", "sequence",
          "internetRxBytes", "internetTxBytes", "mediaDownloadedBytes", "cacheReusedBytes",
          "trafficAvoidedBytes", "cachePlaybackHits", "remotePlaybackCount", "fallbackPlaybackCount",
          "cacheablePlaybackCount", "cacheHitRate", "observedUptimeSeconds", "provedPlaybackSeconds",
          "provedOnlineSeconds", "provedOfflineSeconds", "sessionIds", "sessionCount", "restartCount",
          "failureCount", "unknownInterruptionCount", "packageName", "versionCode", "versionName",
          "lastCommunicationAt"
        ])
        && validDailyTelemetryTypes(payload)
        && validDailyTelemetryValues(payload)
        && validTelemetryDayId(dayId)
        && payload.dateKey == dayId;
    }

    function dailyTelemetryIsMonotonic(previous, next) {
      return next.sequence > previous.sequence
        && next.internetRxBytes >= previous.internetRxBytes
        && next.internetTxBytes >= previous.internetTxBytes
        && next.mediaDownloadedBytes >= previous.mediaDownloadedBytes
        && next.cacheReusedBytes >= previous.cacheReusedBytes
        && next.trafficAvoidedBytes >= previous.trafficAvoidedBytes
        && next.cachePlaybackHits >= previous.cachePlaybackHits
        && next.remotePlaybackCount >= previous.remotePlaybackCount
        && next.fallbackPlaybackCount >= previous.fallbackPlaybackCount
        && next.cacheablePlaybackCount >= previous.cacheablePlaybackCount
        && next.observedUptimeSeconds >= previous.observedUptimeSeconds
        && next.provedPlaybackSeconds >= previous.provedPlaybackSeconds
        && next.provedOnlineSeconds >= previous.provedOnlineSeconds
        && next.provedOfflineSeconds >= previous.provedOfflineSeconds
        && next.sessionCount >= previous.sessionCount
        && next.restartCount >= previous.restartCount
        && next.failureCount >= previous.failureCount
        && next.unknownInterruptionCount >= previous.unknownInterruptionCount;
    }

    function validTelemetryEvent(clientId, screenId, eventId, payload) {
      return isClientOperational(clientId)
        && hasActivePlayerBinding(clientId, screenId)
        && historyIdentityMatches(clientId, screenId, payload)
        && payload.keys().hasOnly([
          "schemaVersion", "id", "clientId", "screenId", "deviceId", "sessionId", "type", "state",
          "domain", "atMs", "mediaId", "mediaType", "reason", "expiresAtMs", "expiresAt"
        ])
        && payload.schemaVersion == 1
        && payload.id is string
        && payload.clientId is string
        && payload.screenId is string
        && payload.deviceId is string
        && payload.id == eventId
        && payload.sessionId is string
        && payload.type is string
        && payload.state is string
        && payload.mediaId is string
        && payload.mediaType is string
        && payload.reason is string
        && payload.domain in ["playback", "connection"]
        && payload.atMs is int
        && payload.atMs >= 0
        && payload.expiresAtMs is int
        && payload.expiresAtMs == payload.atMs + 15552000000
        && payload.expiresAt is timestamp
        && payload.expiresAt == timestamp.value(payload.expiresAtMs);
    }

    function playerActivityChanged() {
      return request.resource.data.get("telemetry", {}).get("activity", {}) != resource.data.get("telemetry", {}).get("activity", {});
    }

    function isAllowedPlayerActivityUpdate(clientId, screenId) {
      let activity = request.resource.data.telemetry.activity;
      return hasActivePlayerBinding(clientId, screenId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["telemetry"])
        && request.resource.data.telemetry.diff(resource.data.telemetry).affectedKeys().hasOnly(["activity"])
        && activity is map
        && activity.keys().hasOnly(["schemaVersion", "events"])
        && activity.schemaVersion == 1
        && activity.events is list
        && activity.events.size() > 0
        && activity.events.size() <= 200
        && activity.events[0].screenId == screenId
        && activity.events[activity.events.size() - 1].screenId == screenId;
    }

    function isAllowedPlayerTelemetryUpdate(clientId, screenId) {
      return hasActivePlayerBinding(clientId, screenId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "activeDeviceId",
          "connectedDeviceId",
          "lastConnection",
          "lastSeenAt",
          "status",
          "telemetry",
          "telemetryUpdatedAt"
        ])
        && request.resource.data.connectedDeviceId == playerBinding().data.deviceId
        && telemetryIdentityMatches(clientId, screenId, request.resource.data.telemetry);
    }

    function isAllowedPlayerCapabilityUpdate(clientId, screenId) {
      return hasActivePlayerBinding(clientId, screenId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "activeDeviceId",
          "capabilities",
          "connectedDeviceId",
          "lastConnection",
          "lastSeenAt",
          "status"
        ])
        && request.resource.data.connectedDeviceId == playerBinding().data.deviceId
        && request.resource.data.status == "online"
        && request.resource.data.capabilities is map
        && ((request.resource.data.capabilities.platform == "WEB" && (
          request.resource.data.capabilities.keys().hasOnly([
            "deviceId",
            "platform",
            "playlistItemNavigation"
          ])
          || (
            request.resource.data.capabilities.keys().hasOnly([
              "deviceId",
              "platform",
              "playlistItemNavigation",
              "templatesV2",
              "templatesV2DynamicPhase1"
            ])
            && request.resource.data.capabilities.keys().hasAll([
              "templatesV2",
              "templatesV2DynamicPhase1"
            ])
            && request.resource.data.capabilities.templatesV2 == true
            && request.resource.data.capabilities.templatesV2DynamicPhase1 == true
          )
        )) || (request.resource.data.capabilities.platform == "ANDROID"
          && request.resource.data.capabilities.keys().hasOnly([
            "deviceId",
            "platform",
            "packageName",
            "versionCode",
            "playlistItemNavigation",
            "templatesV2",
            "templatesV2DynamicPhase1"
          ])
          && request.resource.data.capabilities.packageName == "br.com.parksolutions.totempark.player.rcsecurelink"
          && request.resource.data.capabilities.versionCode in [58, 59, 60, 61, 62, 63, 64, 65, 66, 67, 68, 69, 70]
          && request.resource.data.capabilities.templatesV2 == true
          && request.resource.data.capabilities.templatesV2DynamicPhase1 == true
        ))
        && request.resource.data.capabilities.deviceId == playerBinding().data.deviceId
        && request.resource.data.capabilities.playlistItemNavigation == true;
    }

    match /clients/{clientId} {
      allow read: if true;
      allow create: if isMaster();
      allow update: if (isMaster() || isClientOwner(clientId)) && !changesFinancialSummary();
      allow delete: if isMaster();

      match /contracts/{contractId} {
        allow read: if isMaster() || isClientOwner(clientId);
        allow write: if false;
      }

      match /invoices/{invoiceId} {
        allow read: if isMaster() || isClientOwner(clientId);
        allow write: if false;
      }

      match /financialNotifications/{notificationId} {
        allow read: if isMaster() || isClientOwner(clientId);
        allow write: if false;
      }

      match /financialAudit/{auditId} {
        allow read: if isMaster();
        allow write: if false;
      }

      match /financialEmailDeliveries/{deliveryId} {
        allow read: if isMaster();
        allow write: if false;
      }

      match /screens/{screenId} {
        allow read: if isClientOperational(clientId);
        allow create, delete: if isMaster() || (isClientOperational(clientId) && isClientOwner(clientId));
        allow update: if isMaster()
          || (isClientOperational(clientId) && (isClientOwner(clientId)
            || isAllowedPublicScreenUpdate()
            || isAllowedPlayerTelemetryUpdate(clientId, screenId)
            || isAllowedPlayerCapabilityUpdate(clientId, screenId)
            || isAllowedPlayerActivityUpdate(clientId, screenId))
            && (!playerActivityChanged() || isAllowedPlayerActivityUpdate(clientId, screenId))
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              "templatesV2TestMode",
              "templatesV2TestModeUpdatedAt",
              "templatesV2TestModeUpdatedBy"
            ]));

        match /telemetrySessions/{sessionId} {
          allow read: if isMaster() || isClientOwner(clientId);
          allow create: if isClientOperational(clientId)
            && hasActivePlayerBinding(clientId, screenId)
            && telemetryIdentityMatches(clientId, screenId, request.resource.data)
            && request.resource.data.session.sessionId == sessionId
            && request.resource.data.sequence is int;
          allow update: if isClientOperational(clientId)
            && hasActivePlayerBinding(clientId, screenId)
            && telemetryIdentityMatches(clientId, screenId, request.resource.data)
            && request.resource.data.session.sessionId == sessionId
            && request.resource.data.sequence is int
            && request.resource.data.sequence >= resource.data.sequence;
          allow delete: if isMaster();
        }

        match /telemetryDaily/{dayId} {
          allow read: if isMaster() || (isClientOperational(clientId) && isClientOwner(clientId));
          allow create: if validDailyTelemetry(clientId, screenId, dayId, request.resource.data);
          allow update: if validDailyTelemetry(clientId, screenId, dayId, request.resource.data)
            && (request.resource.data == resource.data
              || dailyTelemetryIsMonotonic(resource.data, request.resource.data));
          allow delete: if isMaster();
        }

        match /telemetryEvents/{eventId} {
          allow read: if isMaster() || (isClientOperational(clientId) && isClientOwner(clientId));
          allow create: if validTelemetryEvent(clientId, screenId, eventId, request.resource.data);
          allow update: if validTelemetryEvent(clientId, screenId, eventId, request.resource.data)
            && request.resource.data == resource.data;
          allow delete: if isMaster();
        }

        match /system/{systemDocument} {
          allow read, write: if false;
        }
      }

      match /media/{mediaId} {
        allow read: if isClientOperational(clientId);
        allow create: if isMaster() || (isClientOperational(clientId) && isClientOwner(clientId));
        allow update: if isMaster() || (isClientOperational(clientId) && isClientOwner(clientId));
        allow delete: if isMaster() || (isClientOperational(clientId) && isClientOwner(clientId));
      }

      match /playlists/{playlistId} {
        allow read: if isClientOperational(clientId);
        allow create, delete: if isMaster() || (isClientOperational(clientId) && isClientOwner(clientId));
        allow update: if isMaster() || (isClientOperational(clientId) && isClientOwner(clientId));
      }

      match /{subcollection}/{documentId} {
        allow read: if !isFinancialSubcollection(subcollection) && isClientOperational(clientId);
        allow write: if !isFinancialSubcollection(subcollection)
          && subcollection != "screens"
          && (isMaster() || (isClientOperational(clientId) && isClientOwner(clientId)));
      }
    }

    match /tv_codes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if isMaster()
        || (isClientOperational(request.resource.data.clientId)
          && isClientOwner(request.resource.data.clientId));
      allow update: if isMaster()
        || (
          request.resource.data.clientId == resource.data.clientId
          && isClientOperational(resource.data.clientId)
          && isClientOwner(resource.data.clientId)
        );
      allow delete: if isMaster()
        || (isClientOperational(resource.data.clientId)
          && isClientOwner(resource.data.clientId));
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isMaster();
    }

    match /playerDeviceBindings/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isMaster();
      allow create, update, delete: if isMaster();
    }

    match /playerRebindAuthorizations/{authorizationId} {
      allow read, write: if false;
    }

    match /account_requests/{requestId} {
      allow create: if isValidPublicAccountRequestCreate();
      allow get: if isMaster() || isOwnAccountRequest();
      allow list, update, delete: if isMaster();
    }

    match /{collection}/{document=**} {
      allow read: if isMaster();
      allow write: if isMaster() && collection != "clients";
    }
  }
}
