+function uploadStorageFile(storageRef, file, metadata, onProgress) {
+  async function buildStableUploadFile() {
+    if (typeof file?.arrayBuffer !== "function") return file;
+
+    const buffer = await file.arrayBuffer();
+    const type = getUploadContentType(file);
+
+    try {
+      return new File([buffer], file.name || "midia", {
+        type,
+        lastModified: file.lastModified || Date.now(),
+      });
+    } catch {
+      return new Blob([buffer], { type });
+    }
+  }
+
+  if (isNativeApp()) {
+    return buildStableUploadFile().then(async (nativeFile) => {
+      onProgress?.(15);
+      const snapshot = await uploadBytes(storageRef, nativeFile, metadata);
+      onProgress?.(100);
+      return snapshot.ref;
+    });
+  }
+
+  function startUpload(uploadFile) {
+    return new Promise((resolve, reject) => {
+      const uploadTask = uploadBytesResumable(storageRef, uploadFile, metadata);
+
+      uploadTask.on(
+        "state_changed",
+        (snapshot) => {
+          const totalBytes = Number(snapshot.totalBytes || 0);
+          const bytesTransferred = Number(snapshot.bytesTransferred || 0);
+          const percent = totalBytes > 0
+            ? Math.round((bytesTransferred / totalBytes) * 100)
+            : 0;
+
+          onProgress?.(percent);
+        },
+        reject,
+        () => resolve(uploadTask.snapshot.ref)
+      );
+    });
+  }
+
+  return startUpload(file);
+}
