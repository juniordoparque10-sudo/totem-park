+
+        setThumbnail(dataUrl);
+        setFailed(false);
+      } catch {
+        fail();
+      }
+    }
+
+    video.onloadedmetadata = () => {
+      if (!active) return;
+
+      onDetectedSize?.(video.videoWidth, video.videoHeight);
+
