+      setFailed(true);
+    }
+
+    function captureFrame() {
+      if (!active) return;
+
+      try {
+        const width = video.videoWidth || 0;
+        const height = video.videoHeight || 0;
+
+        if (!width || !height) {
+          fail();
+          return;
+        }
+
+        onDetectedSize?.(width, height);
